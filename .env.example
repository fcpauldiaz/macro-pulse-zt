# Clerk auth for pulse API (required)
PULSE_EMAIL=
PULSE_PASSWORD=

# Required when Clerk asks for an email verification code after password login.
# Optional if PULSE_EMAIL is a supported disposable address (inbox is polled automatically).
# PULSE_MFA_CODE=

# Password for mail.tm inbox API access (recommended for server/cron MFA).
# Create an inbox with: python -m scraper.scrape_pulse setup-email
# PULSE_EMAIL_PASSWORD=

# Token for tempmail.lol inbox API access (inbox expires quickly on free tier).
# PULSE_EMAIL_TOKEN=

# Force disposable inbox polling even for non-disposable domains (default: auto-detect domain).
# PULSE_USE_DISPOSABLE_INBOX=true

# Inbox polling tuning (seconds).
# PULSE_EMAIL_CODE_TIMEOUT=120
# PULSE_EMAIL_POLL_INTERVAL=3

# Preferred for unattended Coolify scheduled sync: copy __session from browser cookies
# after completing a manual login (including email code).
CLERK_SESSION=

# Optional saved cookie JSON from a successful login
# PULSE_SESSION_PATH=.pulse_session.json

# Turso / libSQL
TURSO_DATABASE_URL=file:local.db
TURSO_AUTH_TOKEN=

# Coolify - Application
#   Dockerfile: Dockerfile
#   Port: 3000

# Coolify - Scheduled task
#   Command: /bin/bash /app/scripts/daily-sync.sh
#   Working directory: /app
#   Env: TURSO_*, plus CLERK_SESSION or PULSE_EMAIL/PULSE_PASSWORD
#   For MFA: use a disposable email on the Clerk account (1secmail/mail.tm/guerrillamail)
#   or set PULSE_MFA_CODE / CLERK_SESSION
