# Clerk auth for pulse API
# Set PULSE_EMAIL_PASSWORD once (or let first sync generate and persist it in Turso).
# The same password is used for mail.tm inbox access and MacroPulse login/sign-up.
PULSE_EMAIL_PASSWORD=

# Optional alias for PULSE_EMAIL_PASSWORD when provisioning a new inbox
# PULSE_PASSWORD=

# Optional: enables fully automatic MacroPulse account creation (bypasses CAPTCHA/MFA)
# CLERK_SECRET_KEY=

# One-time MFA code override (normally fetched from disposable inbox automatically)
# PULSE_MFA_CODE=

# Token for tempmail.lol inbox API access (inbox expires quickly on free tier)
# PULSE_EMAIL_TOKEN=

# Force disposable inbox polling even for non-disposable domains (default: auto-detect domain)
# PULSE_USE_DISPOSABLE_INBOX=true

# Inbox polling tuning (seconds)
# PULSE_EMAIL_CODE_TIMEOUT=120
# PULSE_EMAIL_POLL_INTERVAL=3

# Preferred for unattended Coolify scheduled sync: copy __session from browser cookies
# after completing a manual login (including email code)
CLERK_SESSION=

# Optional saved cookie JSON from a successful login
# PULSE_SESSION_PATH=.pulse_session.json

# Turso / libSQL
TURSO_DATABASE_URL=file:local.db
TURSO_AUTH_TOKEN=

# Coolify - Application
#   Dockerfile: Dockerfile
#   Port: 3000

# Coolify - Scheduled task
#   Command: /bin/bash /app/scripts/daily-sync.sh
#   Working directory: /app
#   Env: TURSO_*, PULSE_EMAIL_PASSWORD (or CLERK_SESSION)
