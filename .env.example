# Clerk auth for pulse API

# Required: mail.td Pro API token (td_...) for temp email inbox + MFA code polling
SMTP_KEY=

# Easiest unattended option: paste __session cookie from browser after manual login
# CLERK_SESSION=

# One-time MFA code override (normally fetched from disposable inbox automatically)
# PULSE_MFA_CODE=

# Inbox file path (optional; default .pulse_inbox.json)
# PULSE_INBOX_PATH=.pulse_inbox.json

# Inbox polling tuning (seconds)
# PULSE_EMAIL_CODE_TIMEOUT=120
# PULSE_EMAIL_POLL_INTERVAL=3

# Optional saved cookie JSON from a successful login
# PULSE_SESSION_PATH=.pulse_session.json

# Turso / libSQL
TURSO_DATABASE_URL=file:local.db
TURSO_AUTH_TOKEN=

# Coolify - Scheduled task
#   Command: /bin/bash /app/scripts/daily-sync.sh
#   Env: TURSO_*, SMTP_KEY (or CLERK_SESSION)

# Setup (one time, no Clerk API keys needed):
# 1. Set SMTP_KEY (mail.td Pro token from https://mail.td/pro/login)
# 2. Run sync once — logs disposable email + MacroPulse password
# 3. Register at https://macro-wrap.vercel.app/sign-up with those credentials
# 4. Re-run sync — login + MFA inbox polling is automatic
