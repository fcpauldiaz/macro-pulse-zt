# Clerk auth for pulse API (required)
PULSE_EMAIL=
PULSE_PASSWORD=

# Required when Clerk asks for an email verification code after password login.
# Not suitable for unattended daily cron unless you automate email retrieval.
# PULSE_MFA_CODE=

# Preferred for unattended Coolify scheduled sync: copy __session from browser cookies
# after completing a manual login (including email code).
CLERK_SESSION=

# Optional saved cookie JSON from a successful login
# PULSE_SESSION_PATH=.pulse_session.json

# Turso / libSQL
TURSO_DATABASE_URL=file:local.db
TURSO_AUTH_TOKEN=

# Coolify - Application
#   Dockerfile: Dockerfile
#   Port: 3000

# Coolify - Scheduled task
#   Command: /bin/bash /app/scripts/daily-sync.sh
#   Working directory: /app
#   Env: TURSO_*, plus CLERK_SESSION or PULSE_EMAIL/PULSE_PASSWORD (+ PULSE_MFA_CODE if prompted)
