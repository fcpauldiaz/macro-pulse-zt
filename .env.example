# Subscriber credentials for authenticated chart scraping (optional)
PULSE_EMAIL=
PULSE_PASSWORD=

# Turso / libSQL
TURSO_DATABASE_URL=file:local.db
TURSO_AUTH_TOKEN=

# Docker / Coolify (single service)
# Build context: . (repo root)
# Dockerfile: Dockerfile
# Port: 3000
# Env: TURSO_DATABASE_URL, TURSO_AUTH_TOKEN
#
# Optional:
# SYNC_CRON_SCHEDULE=0 13 * * *
# RUN_SYNC_ON_START=true
