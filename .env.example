# Clerk session for pulse API (required for sync — copy from browser, no Playwright in cron)
# DevTools → Application → Cookies → macro-wrap.vercel.app → __session
CLERK_SESSION=

# Optional: path to session JSON from `python -m scraper.scrape_pulse login` (local only)
# PULSE_SESSION_PATH=.pulse_session.json

# Optional: only needed for local Playwright login command, not Coolify scheduled sync
PULSE_EMAIL=
PULSE_PASSWORD=

# Turso / libSQL
TURSO_DATABASE_URL=file:local.db
TURSO_AUTH_TOKEN=

# Coolify - Application (always running)
#   Build context: . (repo root)
#   Dockerfile: Dockerfile
#   Port: 3000
#   Env: TURSO_DATABASE_URL, TURSO_AUTH_TOKEN

# Coolify - Scheduled task (daily sync, same image)
#   Command: /bin/bash /app/scripts/daily-sync.sh
#   Working directory: /app
#   Required env: TURSO_DATABASE_URL, TURSO_AUTH_TOKEN, CLERK_SESSION
