# MacroPulse scraper auth uses mail.tm browser login on every run.

# One-time MFA code override (normally read from https://mail.tm/en/ automatically)
# PULSE_MFA_CODE=

# Persisted mail.tm browser state so the same disposable inbox is reused (optional)
# PULSE_MAILTM_STATE_PATH=.pulse_mailtm_state.json

# Inbox credentials file (optional; default .pulse_inbox.json)
# PULSE_INBOX_PATH=.pulse_inbox.json

# Inbox polling tuning (seconds)
# PULSE_EMAIL_CODE_TIMEOUT=120
# PULSE_EMAIL_POLL_INTERVAL=3

# Turso / libSQL
TURSO_DATABASE_URL=file:local.db
TURSO_AUTH_TOKEN=

# Coolify - Scheduled task
#   Command: /bin/bash /app/scripts/daily-sync.sh
#   Env: TURSO_*

# Setup (one time, no Clerk API keys needed):
# 1. Run sync once — opens https://mail.tm/en/, logs disposable email + MacroPulse password
# 2. Register at https://macro-wrap.vercel.app/sign-up with those credentials
# 3. Re-run sync — fresh Clerk login + MFA polling on mail.tm every run
