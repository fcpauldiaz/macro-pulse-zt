# Subscriber credentials for authenticated pulse API access
PULSE_EMAIL=
PULSE_PASSWORD=

# Optional: raw Clerk session cookie (skip Playwright login)
# CLERK_SESSION=

# Optional: path to saved session cookies JSON
# PULSE_SESSION_PATH=.pulse_session.json

# Turso / libSQL
TURSO_DATABASE_URL=file:local.db
TURSO_AUTH_TOKEN=

# Coolify - Application (always running)
#   Build context: . (repo root)
#   Dockerfile: Dockerfile
#   Port: 3000
#   Env: TURSO_DATABASE_URL, TURSO_AUTH_TOKEN, PULSE_EMAIL, PULSE_PASSWORD

# Coolify - Scheduled task (daily sync, same image)
#   Recommended command: /bin/bash /app/scripts/daily-sync.sh
#   Alternative command:  python -m scraper.scrape_pulse sync
#   Working directory:    /app
#   Env: TURSO_DATABASE_URL, TURSO_AUTH_TOKEN, PULSE_EMAIL, PULSE_PASSWORD
