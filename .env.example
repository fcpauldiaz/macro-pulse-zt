# Subscriber credentials for authenticated chart scraping (optional)
PULSE_EMAIL=
PULSE_PASSWORD=

# Turso / libSQL
TURSO_DATABASE_URL=file:local.db
TURSO_AUTH_TOKEN=

# Coolify scheduled task (daily):
#   /bin/bash /app/scripts/daily-sync.sh

# Coolify - Dashboard service
#   Build context: dashboard/
#   Dockerfile: dashboard/Dockerfile
#   Port: 3000
#   Env: TURSO_DATABASE_URL, TURSO_AUTH_TOKEN

# Coolify - Scraper scheduled task
#   Build context: . (repo root)
#   Dockerfile: Dockerfile.scraper
#   Command: /bin/bash ./scripts/daily-sync.sh
#   Env: TURSO_DATABASE_URL, TURSO_AUTH_TOKEN
